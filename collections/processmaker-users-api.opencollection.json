{
  "opencollection": "1.0.0",
  "info": {
    "name": "ProcessMaker Platform RESTful Environment Variables Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns all users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.processmaker.net/api/1.0/users",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status - ACTIVE or INACTIVE"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter results by string. Searches Name, Description, and Status. Status must match exactly. Others can be a substring.\n"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to order results by"
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Include data from related models in payload. Comma separated list."
              },
              {
                "name": "exclude_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated user IDs to exclude"
              }
            ]
          },
          "docs": "Returns all users"
        },
        {
          "info": {
            "name": "Save a new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{organization}.processmaker.net/api/1.0/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Save a new user"
        },
        {
          "info": {
            "name": "Get single user by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.processmaker.net/api/1.0/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get single user by ID"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{organization}.processmaker.net/api/1.0/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{organization}.processmaker.net/api/1.0/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a user"
        },
        {
          "info": {
            "name": "Restore a soft deleted user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{organization}.processmaker.net/api/1.0/users/restore",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Restore a soft deleted user"
        },
        {
          "info": {
            "name": "Returns all users and their total tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.processmaker.net/api/1.0/users_task_count",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter results by string. Searches Name, Description, and Status. Status must match exactly. Others can be a substring.\n"
              },
              {
                "name": "include_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated user IDs to include"
              }
            ]
          },
          "docs": "Returns all users and their total tasks"
        }
      ]
    }
  ],
  "bundled": true
}