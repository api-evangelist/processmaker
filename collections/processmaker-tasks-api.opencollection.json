{
  "opencollection": "1.0.0",
  "info": {
    "name": "ProcessMaker Platform RESTful Environment Variables Tasks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns all tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.processmaker.net/api/1.0/tasks",
            "params": [
              {
                "name": "process_request_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "all_tasks",
                "value": "",
                "type": "query"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter results by string. Searches Name, Description, and Status. Status must match exactly. Others can be a substring.\n"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to order results by"
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Include data from related models in payload. Comma separated list."
              }
            ]
          },
          "docs": "Returns all tasks"
        },
        {
          "info": {
            "name": "Get task by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.processmaker.net/api/1.0/tasks/:task_id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Include data from related models in payload. Comma separated list."
              }
            ]
          },
          "docs": "Get task by ID"
        },
        {
          "info": {
            "name": "Update a task",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{organization}.processmaker.net/api/1.0/tasks/:task_id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a task"
        }
      ]
    }
  ],
  "bundled": true
}